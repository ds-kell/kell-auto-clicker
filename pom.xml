<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>kell.autoclick</groupId>
    <artifactId>auto-clicker</artifactId>
    <version>5.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jnativehook.version>2.2.2</jnativehook.version>
        <gson.version>2.11.0</gson.version>

        <app.name>Kell Auto Clicker</app.name>
        <app.vendor>Kell</app.vendor>
        <app.main-class>kell.autoclick.Main</app.main-class>
        <app.icon.win>${project.basedir}/src/main/resources/static/images/click_pointer.ico</app.icon.win>
        <app.icon.mac>${project.basedir}/src/main/resources/static/images/click_pointer.icns</app.icon.mac>

        <!--
            Bundled Windows JRE for the portable .exe distribution. The Adoptium
            API picks the latest Temurin 25 GA build for the requested platform.
            Override these on the command line if you need a specific version.
        -->
        <jre.win.url>https://api.adoptium.net/v3/binary/latest/25/ga/windows/x64/jre/hotspot/normal/eclipse?project=jdk</jre.win.url>

        <!--
            Modules our app actually uses. Detected by running:
              jdeps print-module-deps multi-release 25 ignore-missing-deps target/auto-clicker.jar
            Re-run when adding a new dependency that pulls in extra JDK APIs.
        -->
        <jlink.modules>java.base,java.compiler,java.desktop,java.management,java.sql</jlink.modules>
        <jlink.image.dir>${project.build.directory}/runtime-image</jlink.image.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.kwhat</groupId>
            <artifactId>jnativehook</artifactId>
            <version>${jnativehook.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Fat JAR with all dependencies (works on any platform) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${app.main-class}</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- JEP 472: grant native access for jnativehook on Java 24+ -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                    <finalName>auto-clicker</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>fat-jar</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Launch4j wraps the fat JAR into a Windows .exe. Runs on any host
                OS so we always get a working Windows .exe even when building
                on macOS.
            -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.2</version>
                <executions>
                    <execution>
                        <id>l4j-clui</id>
                        <phase>package</phase>
                        <goals><goal>launch4j</goal></goals>
                        <configuration>
                            <icon>${app.icon.win}</icon>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/auto-clicker.exe</outfile>
                            <jar>${project.build.directory}/auto-clicker.jar</jar>
                            <classPath>
                                <mainClass>${app.main-class}</mainClass>
                            </classPath>
                            <jre>
                                <!--
                                    Path is relative to the .exe at runtime.
                                    The "windows-portable" profile drops a JRE into
                                    target/dist/windows-portable/jre next to the exe.
                                -->
                                <path>jre</path>
                                <minVersion>25</minVersion>
                                <requiresJdk>false</requiresJdk>
                                <opts>
                                    <opt>--enable-native-access=ALL-UNNAMED</opt>
                                </opts>
                            </jre>
                            <versionInfo>
                                <fileVersion>5.0.0.0</fileVersion>
                                <txtFileVersion>5.0.0.0</txtFileVersion>
                                <fileDescription>${app.name}</fileDescription>
                                <copyright>Copyright 2024</copyright>
                                <productVersion>5.0.0.0</productVersion>
                                <txtProductVersion>5.0.0.0</txtProductVersion>
                                <productName>${app.name}</productName>
                                <internalName>auto-clicker</internalName>
                                <originalFilename>auto-clicker.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            ───────── Windows portable ZIP (cross-platform build) ─────────
            Always active. Downloads a Windows JRE from Adoptium, unpacks it,
            and assembles target/dist/auto-clicker-windows-portable.zip
            containing auto-clicker.exe + jre/. The end user just unzips and
            double-clicks the .exe — no Java installation required.

            Skip with: mvn package -Dskip.win.portable
        -->
        <profile>
            <id>windows-portable</id>
            <activation>
                <property>
                    <name>!skip.win.portable</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <!--
                                Download + extract the Windows JRE.
                                The download is cached in ~/.m2/cache/jre so it
                                happens only once per JRE version.
                            -->
                            <execution>
                                <id>fetch-windows-jre</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <property name="jre.cache.dir"
                                                  value="${user.home}/.m2/cache/temurin-jre/win-x64-25"/>
                                        <property name="jre.cache.zip"
                                                  value="${jre.cache.dir}/jre.zip"/>
                                        <property name="jre.staging.dir"
                                                  value="${project.build.directory}/jre-win-x64"/>
                                        <property name="dist.dir"
                                                  value="${project.build.directory}/dist/windows-portable"/>

                                        <mkdir dir="${jre.cache.dir}"/>
                                        <!-- skipexisting handles caching: re-uses jre.zip if already present -->
                                        <get src="${jre.win.url}"
                                             dest="${jre.cache.zip}"
                                             usetimestamp="true"
                                             skipexisting="true"/>

                                        <delete dir="${jre.staging.dir}" quiet="true"/>
                                        <mkdir dir="${jre.staging.dir}"/>
                                        <unzip src="${jre.cache.zip}" dest="${jre.staging.dir}"/>

                                        <!--
                                            Adoptium archives unpack to a single
                                            jdk-25.x.x+x-jre/ directory. Find it
                                            and copy its contents into dist/.../jre/.
                                        -->
                                        <pathconvert property="jre.extracted.root" setonempty="false">
                                            <dirset dir="${jre.staging.dir}" includes="jdk-*-jre"/>
                                        </pathconvert>
                                        <fail message="Adoptium archive layout changed — could not find jdk-*-jre directory inside ${jre.staging.dir}"
                                              unless="jre.extracted.root"/>

                                        <delete dir="${dist.dir}" quiet="true"/>
                                        <mkdir dir="${dist.dir}/jre"/>
                                        <copy todir="${dist.dir}/jre">
                                            <fileset dir="${jre.extracted.root}"/>
                                        </copy>
                                        <copy file="${project.build.directory}/auto-clicker.exe"
                                              todir="${dist.dir}"/>

                                        <!-- Final deliverable: single zip the user downloads. -->
                                        <zip destfile="${project.build.directory}/dist/auto-clicker-windows-portable.zip"
                                             basedir="${project.build.directory}/dist"
                                             includes="windows-portable/**"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ───────── macOS: jlink slim runtime + jpackage .app/.dmg ───────── -->
        <profile>
            <id>mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!--
                                jlink: build a stripped-down JRE that contains
                                only the modules we actually use. Cuts the bundled
                                runtime from ~180MB (full JDK) to ~50MB.
                            -->
                            <execution>
                                <id>jlink-mac-runtime</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>rm -rf "${jlink.image.dir}" "${project.build.directory}/jpackage-input" "${project.build.directory}/dist" &amp;&amp; jlink --add-modules ${jlink.modules} --output "${jlink.image.dir}" --strip-debug --no-header-files --no-man-pages --compress=zip-6 &amp;&amp; mkdir -p "${project.build.directory}/jpackage-input" &amp;&amp; cp "${project.build.directory}/auto-clicker.jar" "${project.build.directory}/jpackage-input/"</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-mac-app-image</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--name</argument><argument>${app.name}</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${app.vendor}</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument><argument>auto-clicker.jar</argument>
                                        <argument>--main-class</argument><argument>${app.main-class}</argument>
                                        <argument>--runtime-image</argument><argument>${jlink.image.dir}</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-mac-dmg</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>dmg</argument>
                                        <argument>--name</argument><argument>${app.name}</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${app.vendor}</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument><argument>auto-clicker.jar</argument>
                                        <argument>--main-class</argument><argument>${app.main-class}</argument>
                                        <argument>--runtime-image</argument><argument>${jlink.image.dir}</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ───────── Windows host: jlink + jpackage app-image / .msi ───────── -->
        <profile>
            <id>windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!--
                                jlink: stripped-down JRE for Windows. Same idea as
                                macOS but uses cmd.exe so it works on Windows hosts.
                            -->
                            <execution>
                                <id>jlink-win-runtime</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>cmd</executable>
                                    <arguments>
                                        <argument>/c</argument>
                                        <argument>if exist "${jlink.image.dir}" rmdir /s /q "${jlink.image.dir}" &amp; if exist "${project.build.directory}\jpackage-input" rmdir /s /q "${project.build.directory}\jpackage-input" &amp; if exist "${project.build.directory}\dist" rmdir /s /q "${project.build.directory}\dist" &amp; jlink --add-modules ${jlink.modules} --output "${jlink.image.dir}" --strip-debug --no-header-files --no-man-pages --compress=zip-6 &amp; mkdir "${project.build.directory}\jpackage-input" &amp; copy "${project.build.directory}\auto-clicker.jar" "${project.build.directory}\jpackage-input\"</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-win-app-image</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>app-image</argument>
                                        <argument>--name</argument><argument>${app.name}</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${app.vendor}</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument><argument>auto-clicker.jar</argument>
                                        <argument>--main-class</argument><argument>${app.main-class}</argument>
                                        <argument>--runtime-image</argument><argument>${jlink.image.dir}</argument>
                                        <argument>--icon</argument><argument>${app.icon.win}</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage-win-msi</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument><argument>msi</argument>
                                        <argument>--name</argument><argument>${app.name}</argument>
                                        <argument>--app-version</argument><argument>${project.version}</argument>
                                        <argument>--vendor</argument><argument>${app.vendor}</argument>
                                        <argument>--input</argument><argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument><argument>auto-clicker.jar</argument>
                                        <argument>--main-class</argument><argument>${app.main-class}</argument>
                                        <argument>--runtime-image</argument><argument>${jlink.image.dir}</argument>
                                        <argument>--icon</argument><argument>${app.icon.win}</argument>
                                        <argument>--dest</argument><argument>${project.build.directory}/dist</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--java-options</argument><argument>--enable-native-access=ALL-UNNAMED</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
