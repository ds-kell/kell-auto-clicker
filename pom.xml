<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>kell.autoclick</groupId>
    <artifactId>auto-clicker</artifactId>
    <version>5.0</version>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.kwhat</groupId>
            <artifactId>jnativehook</artifactId>
            <version>2.2.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>11</release>
                </configuration>
            </plugin>

            <!-- Fat JAR with all dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>kell.autoclick.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- Required for jnativehook on JDK 17+ -->
                            <Add-Opens>java.base/java.lang=ALL-UNNAMED</Add-Opens>
                        </manifestEntries>
                    </archive>
                    <finalName>auto-clicker</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Launch4j wraps the fat JAR into a Windows .exe.
                To bundle a JRE so the app runs WITHOUT Java installed:
                  1. Download a JRE (e.g. Eclipse Temurin 11 JRE for Windows x64)
                  2. Extract it to a folder, e.g. "jre" next to pom.xml
                  3. Set <path> below to that folder (relative to project root)
                  4. Distribute the exe + the jre folder together

                If you want a fully self-contained single exe, use jpackage (JDK 14+)
                or GraalVM native-image instead.
            -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.5.0</version>
                <executions>
                    <execution>
                        <id>l4j-clui</id>
                        <phase>package</phase>
                        <goals><goal>launch4j</goal></goals>
                        <configuration>
                            <icon>src/main/resources/static/images/click_pointer.ico</icon>
                            <headerType>gui</headerType>
                            <outfile>target/auto-clicker.exe</outfile>
                            <jar>target/auto-clicker.jar</jar>
                            <classPath>
                                <mainClass>kell.autoclick.Main</mainClass>
                            </classPath>
                            <jre>
                                <!--
                                    Bundled JRE path (relative to the exe location at runtime).
                                    If the folder doesn't exist, Launch4j falls back to system Java.
                                    Set this to "jre" and ship a JRE folder next to the exe.
                                -->
                                <path>./jre</path>
                                <minVersion>11</minVersion>
                                <requiresJdk>false</requiresJdk>
                                <opts>
                                    <opt>--enable-native-access=ALL-UNNAMED</opt>
                                </opts>
                            </jre>
                            <versionInfo>
                                <fileVersion>5.0.0.0</fileVersion>
                                <txtFileVersion>5.0.0.0</txtFileVersion>
                                <fileDescription>Kell Auto Clicker</fileDescription>
                                <copyright>Copyright 2024</copyright>
                                <productVersion>5.0.0.0</productVersion>
                                <txtProductVersion>5.0.0.0</txtProductVersion>
                                <productName>Kell Auto Clicker</productName>
                                <internalName>auto-clicker</internalName>
                                <originalFilename>auto-clicker.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
